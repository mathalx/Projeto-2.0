# Configurações do Aplicativo
APP_NAME="Aplicativo de Visitas Técnicas de Segurança do Trabalho"
APP_ENV=development
DEBUG=True

# Configurações de Banco de Dados
DATABASE_URL=sqlite:///storage/database.sqlite3

# Segurança
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# Backend Xano (veja xano/README.md)
# URL do API group, sem barra no final:
XANO_BASE_URL=https://SEU-INSTANCIA.xano.io/api:acnnorte
# Token opcional para chamadas administrativas ao Xano; não versione o token real.
XANO_AUTH_TOKEN=

# Clima automático (CHANGE 08 / módulo v2)
# Crie uma chave gratuita em https://openweathermap.org/api
# Sem chave, o aplicativo usa automaticamente a Open-Meteo (sem cadastro).
OPENWEATHER_API_KEY=

# Scanner de EPI (CHANGE 11)
# Opcional: instale o Tesseract OCR no sistema para leitura de CA/EPI.
# Windows: https://github.com/UB-Mannheim/tesseract/wiki
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
