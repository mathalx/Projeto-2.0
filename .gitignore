*.db
*.sqlite3

# Arquivos temporários
tmp/
temp/

# Arquivos gerados
storage/photos/*
storage/reports/*
storage/exports/*

# Manter estrutura das pastas de armazenamento
!storage/photos/.gitkeep
!storage/reports/.gitkeep
!storage/exports/.gitkeep
